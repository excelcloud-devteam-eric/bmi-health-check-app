{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTerraformStatePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::bmi-health-check-app-tfstate-124666675812",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "bmi-health-check-app/terraform.tfstate",
            "bmi-health-check-app/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ManageTerraformState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::bmi-health-check-app-tfstate-124666675812/bmi-health-check-app/terraform.tfstate",
        "arn:aws:s3:::bmi-health-check-app-tfstate-124666675812/bmi-health-check-app/terraform.tfstate.tflock"
      ]
    }
  ]
}
